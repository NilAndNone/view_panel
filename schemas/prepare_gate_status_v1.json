{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prepare_gate_status_v1.json",
  "$defs": {
    "error_code": {
      "type": "string",
      "enum": [
        "P05_E_PERSONA_SET_EMPTY",
        "P05_E_PERSONA_ENTRY_NON_DIRECTORY",
        "P05_E_PERSONA_IO_ERROR",
        "P05_E_DISPATCH_INPUT_INVALID",
        "P05_E_DISPATCH_INPUT_FIELDS_INVALID",
        "P05_E_MANIFEST_INVALID",
        "P05_E_MANIFEST_PERSONA_ID_MISMATCH",
        "P05_E_HASH_EVIDENCE_UNREADABLE",
        "P05_E_HASH_LEDGER_INVALID",
        "P05_E_HASH_LEDGER_KEY_MISSING",
        "P05_E_HASH_FORMAT_INVALID",
        "P05_E_HASH_MISMATCH",
        "P05_E_HASH_PAYLOAD_UNREADABLE",
        "P05_E_BUNDLE_MISMATCH",
        "P05_E_AUDIT_PATH_NOT_WRITABLE",
        "P05_E_REQUIRED_ARTIFACT_MISSING_DISPATCH_INPUT",
        "P05_E_REQUIRED_ARTIFACT_MISSING_AGENTS",
        "P05_E_REQUIRED_ARTIFACT_MISSING_PROMPT",
        "P05_E_REQUIRED_ARTIFACT_MISSING_MANIFEST",
        "P05_E_REQUIRED_ARTIFACT_MISSING_HASHES",
        "P05_E_REQUIRED_ARTIFACT_UNREADABLE",
        "P05_E_REQUIRED_ARTIFACT_PATH_INVALID"
      ]
    },
    "persona_result": {
      "type": "object",
      "required": [
        "persona_id",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "persona_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "error_code": {
          "$ref": "#/$defs/error_code"
        },
        "error_message": {
          "type": "string"
        }
      }
    },
    "check_result": {
      "type": "object",
      "required": [
        "check_id",
        "status",
        "persona_results"
      ],
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "error_code": {
          "$ref": "#/$defs/error_code"
        },
        "error_message": {
          "type": "string"
        },
        "persona_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/persona_result"
          }
        }
      }
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "status",
    "can_proceed_to_stage2",
    "persona_ids",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "prepare_gate_status_v1"
    },
    "stage": {
      "const": "01_prepare"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "can_proceed_to_stage2": {
      "type": "boolean"
    },
    "persona_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": false,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/check_result"
            },
            {
              "properties": {
                "check_id": {
                  "const": "prepare-persona-discovery"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/check_result"
            },
            {
              "properties": {
                "check_id": {
                  "const": "prepare-required-artifacts"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/check_result"
            },
            {
              "properties": {
                "check_id": {
                  "const": "prepare-dispatch-input-schema"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/check_result"
            },
            {
              "properties": {
                "check_id": {
                  "const": "prepare-hash-and-bundle"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/check_result"
            },
            {
              "properties": {
                "check_id": {
                  "const": "prepare-audit-writability"
                },
                "persona_results": {
                  "type": "array",
                  "maxItems": 0
                }
              }
            }
          ]
        }
      ]
    }
  }
}
